{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geologyrocks.example/schemas/scenario.schema.json",
  "title": "Golden scenario test",
  "type": "object",
  "required": [
    "id",
    "title",
    "author",
    "setup",
    "steps",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "setup": {
      "type": "object",
      "properties": {
        "pack": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "array",
            "null"
          ]
        },
        "find_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "prior": {
          "enum": [
            "uniform",
            "pack",
            "explicit"
          ]
        },
        "explicit_prior": {
          "type": "object"
        },
        "kit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "beginner",
            "expert"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "object",
            "required": [
              "char",
              "state"
            ],
            "properties": {
              "char": {
                "type": "string"
              },
              "state": {
                "type": [
                  "string",
                  "array"
                ]
              }
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "reported_node_is": {
                "type": "string"
              },
              "reported_node_is_ancestor_of": {
                "type": "string"
              },
              "reported_level_at_least": {
                "type": "string"
              },
              "top_leaf_is": {
                "type": "string"
              },
              "top_leaf_in": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "p_at_least": {
                "type": "object"
              },
              "p_at_most": {
                "type": "object"
              },
              "not_suggested": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "suggested_first_in": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
