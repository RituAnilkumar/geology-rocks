{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geologyrocks.example/schemas/pack_manifest.schema.json",
  "title": "Regional pack manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "extent",
    "version",
    "requires_core",
    "sources",
    "layers",
    "map_style"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9\\-]+$"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/i18n"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/i18n"
    },
    "extent": {
      "type": "object",
      "required": [
        "bbox"
      ],
      "properties": {
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "version": {
      "type": "string"
    },
    "requires_core": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taxa_present": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "curated_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/i18n"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "licence",
          "attribution"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "required": [
        "offline"
      ],
      "properties": {
        "offline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompted_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "online": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "wms",
                  "wmts",
                  "xyz"
                ]
              },
              "source": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "terms": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "map_style": {
      "type": "object",
      "required": [
        "draw_boundaries"
      ],
      "properties": {
        "draw_boundaries": {
          "const": false
        }
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
